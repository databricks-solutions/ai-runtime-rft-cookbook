# Workspace settings for submitting jobs. Copy to site.env (gitignored), fill in, then
# `source site.env` before `databricks air run`. Secrets are referenced by scope/key, never inlined.

RFT_PROFILE=my-workspace                                          # Databricks CLI profile
RFT_VOLUME_ROOT=/Volumes/<catalog>/<schema>/<volume>/rft-cookbook # data, models, checkpoints, evaluations
RFT_VERL_IMAGE='<catalog>.<schema>.<image>:<tag>'                 # frameworks/verl/image, pushed with `databricks air images push`
RFT_MILES_IMAGE='<catalog>.<schema>.<image>:<tag>'                # frameworks/miles/image, pushed the same way
RFT_HF_TOKEN_SECRET='<scope>/<key>'                               # a Databricks secret holding a Hugging Face token
RFT_VS_INDEX='<catalog>.<schema>.<index>'                         # agentic search: its Vector Search index
# A tag can move: the digest `databricks air images push` printed, for the run's record:
# RFT_VERL_IMAGE_DIGEST='<catalog>.<schema>.<image>@sha256:<digest>'   (likewise RFT_MILES_IMAGE_DIGEST)
