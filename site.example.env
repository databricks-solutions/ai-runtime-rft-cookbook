# Workspace settings for submitting jobs. Copy to site.env (gitignored), fill in, then
# `source site.env` before `air run`. Secrets are referenced by scope/key, never inlined.

RFT_PROFILE=my-workspace                                          # Databricks CLI profile
RFT_VOLUME_ROOT=/Volumes/<catalog>/<schema>/<volume>/rft-cookbook # data, models, checkpoints, evaluations
RFT_VERL_IMAGE='<registry>/<repository>:<tag>@sha256:<digest>'    # built from frameworks/verl/image
RFT_MILES_IMAGE='<registry>/<repository>:<tag>@sha256:<digest>'   # miles' dependencies (frameworks/miles/README.md)
RFT_HF_TOKEN_SECRET='<scope>/<key>'                               # a Databricks secret holding a Hugging Face token
